generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(uuid())
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  passwordHash   String
  name           String
  aiProvider     String             @default("openai")
  aiApiKey       String?
  slideStructure String?            @db.Text
  hoursSaved     Int                @default(0)
  classes        ClassGroup[]
  rooms          Room[]
  lessons        LessonPlan[]
  notes          DailyNote[]
  tasks          KanbanTask[]
  timetable      TimetableSlot[]
  templates      Template[]
  seating        SeatingPlan[]
  assessments    Assessment[]
  pushSubs       PushSubscription[]
  dropBoxes      TaskDropBox[]
}

model ClassGroup {
  id          String          @id @default(uuid())
  name        String         
  colorHex    String          @default("#e2e8f0") 
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
  archivedAt  DateTime?
  lessons     LessonPlan[]
  timetable   TimetableSlot[]
  seating     SeatingPlan[]
  students    Student[]      
  assessments Assessment[]

  @@unique([teacherId, name])
}

model Student {
  id            String        @id @default(uuid())
  externalRef   String?       
  name          String
  sen           Boolean       @default(false)
  pp            Boolean       @default(false)
  fsm           Boolean       @default(false)
  medicalNotes  String?
  readingAge    String?
  keepApartFrom String?       
  targetGrade   String?

  classId       String
  class         ClassGroup    @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  grades        Grade[]
  behaviorLogs  BehaviorLog[]

  @@unique([classId, externalRef])
  @@index([classId])
}

model Assessment {
  id          String        @id @default(uuid())
  title       String
  date        DateTime      @db.Date
  
  classId     String
  class       ClassGroup    @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  teacherId   String
  teacher     User          @relation(fields: [teacherId], references: [id])
  
  grades      Grade[]
}

model Grade {
  id           String      @id @default(uuid())
  value        String      
  
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  assessmentId String
  assessment   Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assessmentId])
  @@index([studentId])
  @@index([assessmentId])
}

enum BehaviorType {
  POSITIVE
  NEGATIVE
}

model BehaviorLog {
  id        String       @id @default(uuid())
  type      BehaviorType 
  points    Int
  reason    String?
  date      DateTime     @default(now())
  
  studentId String
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, date])
}

model Room {
  id          String        @id @default(uuid())
  name        String
  teacherId   String
  teacher     User          @relation(fields: [teacherId], references: [id])
  seating     SeatingPlan[]

  @@unique([teacherId, name])
}

enum TimetableEntryType { 
  CLASS
  PPA
  DUTY
  HOY
  MEETING
  OTHER 
}

model TimetableSlot {
  id          String             @id @default(uuid())
  teacherId   String
  entryType   TimetableEntryType
  classId     String?
  label       String?            
  dayOfWeek   Int
  weekType    String
  period      Int

  teacher     User               @relation(fields: [teacherId], references: [id])
  class       ClassGroup?        @relation(fields: [classId], references: [id])

  @@unique([teacherId, weekType, dayOfWeek, period])
}

model LessonPlan {
  id          String          @id @default(uuid())
  date        DateTime        @db.Date
  period      Int
  planText    String   
  classId     String?
  class       ClassGroup?     @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
  version     Int             @default(1)
  updatedAt   DateTime        @updatedAt

  @@unique([teacherId, date, period])
  @@index([teacherId, date])
}

model DailyNote {
  id          String          @id @default(uuid())
  date        DateTime        @db.Date
  noteText    String
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
  version     Int             @default(1)
  updatedAt   DateTime        @updatedAt

  @@unique([teacherId, date])
}

enum TaskStatus { 
  TODO
  IN_PROGRESS
  DONE 
}

enum TaskPriority { 
  LOW
  NORMAL
  HIGH
  URGENT 
}

model KanbanTask {
  id              String       @id @default(uuid())
  title           String
  notes           String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(NORMAL)
  dueAt           DateTime?
  completedAt     DateTime?
  clientCreatedAt DateTime?
  teacherId       String
  teacher         User         @relation(fields: [teacherId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([teacherId, status])
}

model TaskDropBox {
  id          String       @id @default(uuid())
  token       String       @unique 
  teacherId   String
  teacher     User         @relation(fields: [teacherId], references: [id])
  isActive    Boolean      @default(true)
}

model Template {
  id          String          @id @default(uuid())
  className   String
  content     String
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, className])
}

model SeatingPlan {
  id          String      @id @default(uuid())
  teacherId   String
  teacher     User        @relation(fields: [teacherId], references: [id])
  
  classId     String
  class       ClassGroup  @relation(fields: [classId], references: [id])

  roomId      String
  room        Room        @relation(fields: [roomId], references: [id])
  
  layoutData  String      @db.Text
  updatedAt   DateTime    @updatedAt

  @@unique([teacherId, classId, roomId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  keys      String   @db.Text
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}
