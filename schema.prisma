generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// True Session Auth Model
model Session {
  id        String   @id @default(uuid())
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

model User {
  id          String         @id @default(uuid())
  email       String         @unique
  name        String
  role        String         @default("teacher")
  classes     ClassGroup[]
  lessons     LessonPlan[]
  notes       DailyNote[]
  tasks       KanbanTask[]
  timetable   TimetableSlot[]
  templates   Template[]
  seating     SeatingPlan[]
}

model ClassGroup {
  id          String         @id @default(uuid())
  name        String         
  colourKey   Int?           // Persisted curated colour
  teacherId   String
  teacher     User           @relation(fields: [teacherId], references: [id])
  lessons     LessonPlan[]
  timetable   TimetableSlot[]
  seating     SeatingPlan[]

  @@unique([teacherId, name])
}

enum TimetableEntryType {
  CLASS
  PPA
  DUTY
  HOY
  MEETING
  OTHER
}

model TimetableSlot {
  id          String             @id @default(uuid())
  teacherId   String
  entryType   TimetableEntryType
  classId     String?
  label       String?            // Used if entryType is NOT CLASS (e.g., "Lunch Duty")
  
  dayOfWeek   Int
  weekType    String
  period      Int

  teacher     User               @relation(fields: [teacherId], references: [id])
  class       ClassGroup?        @relation(fields: [classId], references: [id])

  @@unique([teacherId, weekType, dayOfWeek, period])
}

model LessonPlan {
  id          String          @id @default(uuid())
  date        DateTime        @db.Date
  period      Int
  planText    String   
  teamsLink   String?
  
  classId     String?
  class       ClassGroup?     @relation(fields: [classId], references: [id])
  
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
  version     Int             @default(1)
  updatedAt   DateTime        @updatedAt

  @@unique([teacherId, date, period])
  @@index([teacherId, date])
}

model DailyNote {
  id          String          @id @default(uuid())
  date        DateTime        @db.Date
  noteText    String
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
  version     Int             @default(1)
  updatedAt   DateTime        @updatedAt

  @@unique([teacherId, date])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model KanbanTask {
  id              String       @id @default(uuid())
  title           String
  notes           String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(NORMAL)
  
  dueAt           DateTime?
  completedAt     DateTime?
  clientCreatedAt DateTime?
  
  teacherId       String
  teacher         User         @relation(fields: [teacherId], references: [id])
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([teacherId, status])
  @@index([teacherId, dueAt])
}

model Template {
  id          String          @id @default(uuid())
  className   String
  content     String
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, className])
}

// Spatial Seating Model (Prep for Free Drag)
model SeatingPlan {
  id          String   @id @default(uuid())
  name        String
  width       Int      @default(1000)
  height      Int      @default(700)
  
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  
  classId     String
  class       ClassGroup @relation(fields: [classId], references: [id])
  
  seats       Seat[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teacherId, classId])
}

model Seat {
  id          String   @id @default(uuid())
  planId      String
  plan        SeatingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  studentName String?
  sen         Boolean  @default(false)
  pp          Boolean  @default(false)
  fsm         Boolean  @default(false)
  notes       String?

  x           Int
  y           Int
  width       Int      @default(140)
  height      Int      @default(80)
  rotation    Int      @default(0)
  locked      Boolean  @default(false)
}
