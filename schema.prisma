generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(uuid())
  email       String         @unique
  name        String
  role        String         @default("teacher")
  classes     ClassGroup[]
  lessons     LessonPlan[]
  notes       DailyNote[]
  tasks       KanbanTask[]
  timetable   TimetableBlock[]
  templates   Template[]
  seating     SeatingPlan[]
}

model ClassGroup {
  id          String         @id @default(uuid())
  name        String         
  teacherId   String
  teacher     User           @relation(fields: [teacherId], references: [id])
}

model LessonPlan {
  id          String          @id @default(uuid())
  date        DateTime        @db.Date
  period      Int
  planText    String   
  teamsLink   String?
  className   String?
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
  version     Int             @default(1)
  updatedAt   DateTime        @updatedAt

  @@unique([teacherId, date, period])
  @@index([teacherId, date])
}

model DailyNote {
  id          String          @id @default(uuid())
  date        DateTime        @db.Date
  noteText    String
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
  version     Int             @default(1)
  updatedAt   DateTime        @updatedAt

  @@unique([teacherId, date])
}

model TimetableBlock {
  id          String          @id @default(uuid())
  dayOfWeek   Int
  weekType    String
  period      Int
  className   String
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, weekType, dayOfWeek, period])
}

model KanbanTask {
  id          String          @id @default(uuid())
  title       String
  status      String          @default("todo") 
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
  updatedAt   DateTime        @updatedAt
}

model Template {
  id          String          @id @default(uuid())
  className   String
  content     String
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, className])
}

model SeatingPlan {
  id          String          @id @default(uuid())
  className   String
  layoutData  String          @db.Text
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, className])
}
