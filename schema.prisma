generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(uuid())
  email       String         @unique
  name        String
  role        String         @default("teacher")
  classes     Class[]
  lessons     LessonPlan[]
  notes       DailyNote[]
  tasks       KanbanTask[]
}

model Class {
  id          String         @id @default(uuid())
  name        String         
  room        String?
  teacherId   String
  teacher     User           @relation(fields: [teacherId], references: [id])
  lessons     LessonPlan[]
}

model LessonPlan {
  id          String          @id @default(uuid())
  date        DateTime
  period      Int
  planText    String   
  teamsLink   String?
  classId     String
  class       Class           @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
}

model DailyNote {
  id          String          @id @default(uuid())
  date        DateTime
  noteText    String
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
}

model TimetableBlock {
  id          String          @id @default(uuid())
  dayOfWeek   Int
  weekType    String
  period      Int
  className   String
}

model KanbanTask {
  id          String          @id @default(uuid())
  title       String
  status      String          @default("todo") 
  teacherId   String
  teacher     User            @relation(fields: [teacherId], references: [id])
}
